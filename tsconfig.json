{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@common/*": [
        "src/common/*"
      ],
      "@infrastructure/*": [
        "src/infrastructure/*"
      ],
      "@user/*": [
        "src/modules/user/*"
      ],
      "@auth/*": [
        "src/modules/auth/*"
      ],
      "@chat/*": [
        "src/modules/chat/*"
      ]
    }
  }
}
